# library(ggrepel)
ggplot(north_europe_gdp, aes(x = year, y = gdp_pc, group = name, color = name)) +
geom_line(linewidth = 1.5) +
geom_text_repel(aes(label = label_first), direction = "y", nudge_x = -1, seed = 1234) +
